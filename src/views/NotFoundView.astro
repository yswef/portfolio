---
import { localizedPath, type ContentSnapshot, type Locale } from '../server/content';
import { t } from '../i18n/ui';

interface Props {
  content: ContentSnapshot;
  locale: Locale;
}

const { content, locale } = Astro.props;
void content;
const links = [
  { path: 'projects', key: 'nav.projects' as const },
  { path: 'apps', key: 'nav.apps' as const },
  { path: 'blog', key: 'nav.blog' as const },
  { path: 'contact', key: 'nav.contact' as const },
];
---

<section class="section">
  <div class="shell stack" style="max-inline-size:60ch">
    <span class="eyebrow">404</span>
    <h1>{t('state.notFoundTitle', locale)}</h1>
    <p class="lede">{t('state.notFoundBody', locale)}</p>
    <ul class="tag-row">
      {links.map((link) => (
        <li>
          <a class="tag tag--plain" href={localizedPath(locale, link.path)}>
            {t(link.key, locale)}
          </a>
        </li>
      ))}
    </ul>
    <a class="btn btn--primary" href={localizedPath(locale, '')}>
      {t('action.backHome', locale)}
    </a>
  </div>
</section>
