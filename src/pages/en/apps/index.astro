---
import Base from '../../../layouts/Base.astro';
import AppsView from '../../../views/AppsView.astro';
import { loadContent } from '../../../server/content';
import { sectionMeta } from '../../../server/page-meta';

const content = loadContent();
const meta = sectionMeta(content, 'en', { kind: 'apps', path: 'apps' });

---

<Base
  content={content}
  locale="en"
  path="apps"
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  jsonLd={meta.jsonLd}
  ogType={meta.ogType}
  keywords={meta.keywords}
>
  <AppsView content={content} locale="en" />
</Base>
