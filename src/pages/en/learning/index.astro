---
import Base from '../../../layouts/Base.astro';
import LearningView from '../../../views/LearningView.astro';
import { loadContent } from '../../../server/content';
import { sectionMeta } from '../../../server/page-meta';

const content = loadContent();
const meta = sectionMeta(content, 'en', { kind: 'learning', path: 'learning' });

---

<Base
  content={content}
  locale="en"
  path="learning"
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  jsonLd={meta.jsonLd}
  ogType={meta.ogType}
  keywords={meta.keywords}
>
  <LearningView content={content} locale="en" />
</Base>
