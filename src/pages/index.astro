---
import Base from '../layouts/Base.astro';
import HomeView from '../views/HomeView.astro';
import { loadContent } from '../server/content';
import { sectionMeta } from '../server/page-meta';

const content = loadContent();
const meta = sectionMeta(content, 'ar', { kind: 'home', path: '' });

---

<Base
  content={content}
  locale="ar"
  path=""
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  jsonLd={meta.jsonLd}
  ogType={meta.ogType}
  keywords={meta.keywords}
>
  <HomeView content={content} locale="ar" />
</Base>
