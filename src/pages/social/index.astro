---
import Base from '../../layouts/Base.astro';
import SocialView from '../../views/SocialView.astro';
import { loadContent } from '../../server/content';
import { sectionMeta } from '../../server/page-meta';

const content = loadContent();
const meta = sectionMeta(content, 'ar', { kind: 'social', path: 'social' });

---

<Base
  content={content}
  locale="ar"
  path="social"
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  jsonLd={meta.jsonLd}
  ogType={meta.ogType}
  keywords={meta.keywords}
>
  <SocialView content={content} locale="ar" />
</Base>
