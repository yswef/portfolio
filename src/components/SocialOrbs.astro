};
---

<ul class="orb-grid" style="list-style:none; padding:0">
  {
    socials.map((social) => (
      <li>
        <a
          class="orb"
          href={social.url}
          target="_blank"
          rel="me noopener"
          style={social.accent ? `--orb-accent:${social.accent}` : undefined}
          data-tilt
        >
          <span class="orb__glyph" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d={iconFor(social.icon || social.platform)} />
            </svg>
          </span>
          <span class="orb__meta">
            <strong>{pick(social.label, locale)}</strong>
            <span>{social.handle ? `@${social.handle.replace(/^@/, '')}` : new URL(social.url).hostname}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
