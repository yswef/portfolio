---
/**
 * Social links rendered as 3D "orbs": a layered badge that rotates in space on
 * hover. Each platform draws its own glyph, all drawn inline so nothing is
 * fetched from a third party.
 */
import { pick, visibleSocials, type ContentSnapshot, type Locale } from '../server/content';

interface Props {
  content: ContentSnapshot;
  locale: Locale;
  limit?: number;
}

const { content, locale, limit } = Astro.props;
const socials = visibleSocials(content).slice(0, limit ?? 40);

