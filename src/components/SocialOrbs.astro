    case 'linkedin':
      return 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05A4.2 4.2 0 0 1 17.6 8.7c3 0 3.4 1.9 3.4 4.4V21h-4v-6.5c0-1.6-.6-2.6-2-2.6-1.1 0-1.8.7-2 1.4-.1.3-.1.7-.1 1V21h-4V9Z';
