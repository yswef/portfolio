    case 'twitter':
      return 'M17.7 3h3.3l-7.2 8.2L21.5 21h-6l-4.3-5.6L6.2 21H3l7.5-8.6L3.2 3h6.1l4 5.3L17.7 3Zm-1.1 16h1.8L7.5 4.9H5.6L16.6 19Z';
    case 'youtube':
      return 'M21.6 7.2c-.2-1.5-.9-2.2-2.4-2.4C17.4 4.6 14.9 4.5 12 4.5s-5.4.1-7.2.3C3.3 5 2.6 5.7 2.4 7.2 2.2 8.7 2.2 10.2 2.2 12s0 3.3.2 4.8c.2 1.5.9 2.2 2.4 2.4 1.8.2 4.3.3 7.2.3s5.4-.1 7.2-.3c1.5-.2 2.2-.9 2.4-2.4.2-1.5.2-3 .2-4.8s0-3.3-.2-4.8ZM10 15.5v-7l6 3.5-6 3.5Z';
