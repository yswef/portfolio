    case 'link':
    default:
      return 'M10.6 13.4a3 3 0 0 1 0-4.2l3-3a3 3 0 0 1 4.2 4.2l-1 1-1.4-1.4 1-1a1 1 0 0 0-1.4-1.4l-3 3a1 1 0 0 0 0 1.4l1.4 1.4-1.4 1.4-1.4-1.4Zm2.8-2.8-1.4-1.4 1.4-1.4 1.4 1.4-1.4 1.4Zm-5 5.2a1 1 0 0 1-1.4 0 1 1 0 0 1 0-1.4l1-1L6.6 12l-1 1a3 3 0 0 0 4.2 4.2l1-1-1.4-1.4-1 1Z';
