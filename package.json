{
  "name": "portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal site, application hub and control panel for Yousif Alhamzi",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-content.mjs && astro build",
    "preview": "npm run build && wrangler pages dev",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:apply:local": "wrangler d1 migrations apply portfolio-db --local",
    "db:apply:remote": "wrangler d1 migrations apply portfolio-db --remote",
    "admin:create": "node scripts/create-admin.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "publish": "node scripts/publish-snapshot.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.3.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "marked": "^18.1.1",
    "svelte": "^5.57.2",
    "three": "^0.186.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
